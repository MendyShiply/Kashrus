# Database (SQLite file; keep it on a persistent disk in production)
DATABASE_URL="file:./data.db"

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# The first admin account (created by `npm run setup`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Rabbi Yosef Dan Kirszenberg"

# Where uploaded videos, thumbnails and signature images are stored
UPLOAD_DIR="./uploads"

# Public URL of the site (used for Stripe redirects and certificate links)
SITE_URL="http://localhost:3000"

# Optional: Stripe for paid course enrollment. Leave blank to approve payments by hand.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
