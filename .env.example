# Database (SQLite file; keep it on a persistent disk in production)
DATABASE_URL="file:./data.db"

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# The first admin account (created by `npm run setup`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Rabbi Yosef Dan Kirszenberg"

# Where uploaded videos, thumbnails and signature images are stored
UPLOAD_DIR="./uploads"

# Public URL of the site (used for Stripe redirects and certificate links)
SITE_URL="http://localhost:3000"

# Optional: Stripe for paid course enrollment. Leave blank to approve payments by hand.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional: show Zoom meetings inside the Live page (Zoom Marketplace → Develop → General App → Meeting SDK)
ZOOM_SDK_KEY=""
ZOOM_SDK_SECRET=""

# Optional: import Zoom cloud recordings, transcripts and AI summaries (Zoom Marketplace → Server-to-Server OAuth app)
# Scopes needed: cloud_recording:read:list_user_recordings:admin, cloud_recording:read:list_recording_files:admin,
#                meeting:read:summary:admin
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Optional: Claude drafts articles, write ups and newsletters from shiur transcripts (console.anthropic.com → API keys).
# Every draft waits for the Rav's approval before it is posted.
ANTHROPIC_API_KEY=""
